# ---- Runtime -----------------------------------------------------------------
APP_ENV=development                 # development | production
PORT=8000                           # HTTP port (Dokploy/Railpack injects PORT)
LOG_LEVEL=INFO
LOG_JSON=false                      # true in production (structured logs)

# ---- Data stores -------------------------------------------------------------
DATABASE_URL=postgresql://postgres:toor@localhost:5432/TibDaftari
REDIS_URL=redis://default:toor@localhost:6379
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ---- Security (generate: python -c "import secrets;print(secrets.token_urlsafe(48))") ----
JWT_SECRET=change-me-please-very-long-random-string
STAFF_TOKEN_TTL_HOURS=12
PATIENT_TOKEN_TTL_HOURS=720
# Fernet key for secrets at rest (Xabarchi API key, Telegram bot token):
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5180,http://localhost:5173
# Public URL of this API (used for links in SMS / Telegram, e.g. PDF links)
PUBLIC_API_URL=http://localhost:8000
# Public URL of the SPA (portal links in SMS)
FRONTEND_URL=http://localhost:5180

# ---- Integrations ------------------------------------------------------------
# Xabarchi SMS server (a unit enters its own API key in Admin → SMS sozlamalari; units below inherit it)
XABARCHI_BASE_URL=https://manager-xabarchi-backend-bula2s-f6aaa1-13-140-185-49.sslip.io
# Eskiz.uz — the second SMS provider (accounts are entered in the UI per unit; these are only the API address and the callback)
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
# ESKIZ_CALLBACK_URL=https://api.example.uz/api/v1/messaging/eskiz/callback
XABARCHI_TIMEOUT_SECONDS=15
# In development OTP codes are returned in the API response (devCode) and logged.
OTP_DEV_MODE=true
OTP_TTL_SECONDS=300

# ---- Background workers ------------------------------------------------------
WORKERS_ENABLED=true                # outbox dispatcher + schedulers in this process
TELEGRAM_ENABLED=true               # start the Telegram bots of the units (long polling)
# The platform bot: used by a unit's telegram account that stores no token of its own (see docs/V2_PORT.md)
TELEGRAM_BOT_TOKEN=
